# Copie este arquivo para `.env` e preencha os valores locais.
# Em produção (Railway/Vercel), estas variáveis são configuradas direto no
# painel da plataforma — nenhum arquivo .env é enviado para lá.

# URL JDBC do Postgres. Valor abaixo já é o default se a variável não for definida.
DB_URL=jdbc:postgresql://localhost:5432/gerenciamento_eventos

# Credenciais do Postgres local.
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Segredo usado para assinar e validar os JWT (HMAC256). Obrigatório, sem default:
# gere um valor novo e aleatório por ambiente, nunca reaproveite entre dev/produção.
# Exemplo de geração: openssl rand -base64 48
JWT_SECRET=

# Chave da Ticketmaster Discovery API. Opcional: se vazia/ausente, o catálogo do
# organizador usa o CatalogoProviderLocal (itens fixos), sem chamar rede nenhuma.
TICKETMASTER_API_KEY=

# Origens (front-end) autorizadas a chamar a API via CORS, separadas por vírgula.
# Vazia em dev: o proxy do Vite evita CORS, então nada precisa ser liberado aqui.
# Em produção, a URL do front publicado (ex.: https://seu-app.vercel.app).
CORS_ALLOWED_ORIGINS=

# Usuários semeados (migration V6 + V8), senha igual para os quatro por serem
# dados de demonstração:
#   organizador@evento.com / senha123  (ORGANIZADOR)
#   cliente1@evento.com    / senha123  (CLIENTE)
#   cliente2@evento.com    / senha123  (CLIENTE)
#   portaria@evento.com    / senha123  (PORTARIA)
